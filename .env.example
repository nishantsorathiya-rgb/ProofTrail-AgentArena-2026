# P1 runs offline. Copy this file locally; never commit .env.
MESH_API_KEY=YOUR_MESH_KEY_HERE
MESH_MODEL_ID=MODEL_ID_FROM_YOUR_MESH_DASHBOARD
MESH_BASE_URL=https://api.meshapi.ai/v1
TAVILY_API_KEY=YOUR_TAVILY_KEY_HERE
DATABASE_URL=sqlite:///./data/prooftrail.db
MAX_LLM_CALLS_PER_RUN=12
MAX_SEARCHES_PER_RUN=6
MAX_FETCHES_PER_RUN=10
MAX_CLAIMS_PER_RUN=18
MAX_RETRIES_PER_SUBQUESTION=2
MAX_PARALLEL_FETCHES=3
HTTP_TIMEOUT_SECONDS=12
MAX_SOURCE_TEXT_CHARS=12000
FETCH_MAX_BYTES=1500000
PAGE_CACHE_TTL_SECONDS=3600
ENABLE_LIVE_REQUESTS=false
# Tavily transport attempts, separate from later semantic research retries.
TAVILY_MAX_ATTEMPTS=3
TAVILY_BACKOFF_INITIAL_SECONDS=0.5
TAVILY_BACKOFF_MAX_SECONDS=10
DNS_TIMEOUT_SECONDS=3
# P3 local orchestration (single Uvicorn worker).
MAX_RESEARCH_SUBQUESTIONS=3
MAX_PARALLEL_RESEARCH_TASKS=3
MAX_ACTIVE_RUNS=1
MAX_PENDING_RUNS=4
WORKFLOW_TIMEOUT_SECONDS=120
# P4 bounded claim drafting and semantic verification (no automatic retry).
MAX_PARALLEL_VERIFICATIONS=3
MAX_VERIFICATION_INPUT_CHARS=12000
MAX_DRAFT_INPUT_CHARS=24000
# P5 total assigned research tasks, including retry assignments.
MAX_RESEARCH_TASKS_PER_RUN=9
